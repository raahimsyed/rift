{
  "name": "rift-proxy",
  "version": "1.0.0",
  "description": "Rift unblocked proxy",
  "main": "server/server.js",
  "scripts": {
    "build:amplify": "node scripts/build-amplify.js",
    "start": "node server/server.js",
    "validate:vercel": "node -e \"const fs=require('fs');const v=JSON.parse(fs.readFileSync('vercel.json','utf8'));const d=v?.rewrites?.[0]?.destination;if(d!=='/api/index'&&d!=='/api/index.js'){throw new Error('vercel.json must rewrite to /api/index(.js)')}console.log('vercel.json ok')\""
  },
  "dependencies": {
    "@mercuryworkshop/bare-mux": "^2.1.6",
    "@mercuryworkshop/epoxy-transport": "^3.0.1",
    "@mercuryworkshop/libcurl-transport": "^1.3.1",
    "@mercuryworkshop/scramjet": "https://github.com/MercuryWorkshop/scramjet/releases/download/v2.0.67-alpha.2/mercuryworkshop-scramjet-2.0.67-alpha.2.tgz",
    "@mercuryworkshop/scramjet-controller": "https://github.com/MercuryWorkshop/scramjet/releases/download/v0.0.14-controller/mercuryworkshop-scramjet-controller-0.0.14.tgz",
    "@mercuryworkshop/wisp-js": "^0.4.1",
    "@titaniumnetwork-dev/ultraviolet": "^3.2.10",
    "@tomphttp/bare-server-node": "^2.0.6",
    "express": "^4.22.1"
  }
}
